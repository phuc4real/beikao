# Optional TURN relay for WebRTC connectivity on restrictive networks
# (symmetric NAT, mobile carriers, corporate firewalls). Without TURN, some
# peers can still connect via STUN, but not all. See TDD.md §4.
#
# Copy to `.env.local` for local dev, or set as GitHub Actions secrets for deploy.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
