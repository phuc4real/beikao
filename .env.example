# Supabase server-authoritative backend — the app's only backend.
# See supabase/README.md and TDD.md §19.
#
# Required for the app to function (create/join rooms, presence, leaderboard).
# The anon key is public and RLS-gated — safe to ship in the client bundle;
# every authoritative mutation goes through Edge Functions (service role).
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
